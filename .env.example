# Sao chép thành .env.local rồi điền giá trị. KHÔNG commit .env.local.

# "local"    = dữ liệu trong .data/db.json, tệp trong storage/ (chạy ngay, không cần tài khoản)
# "supabase" = PostgreSQL + Auth + Storage của Supabase (dùng khi triển khai)
DATA_BACKEND=local

# --- Chế độ local: tài khoản quản trị duy nhất ---
ADMIN_EMAIL=admin@studyhub.local
ADMIN_PASSWORD=doi-mat-khau-nay
# Chuỗi ngẫu nhiên >= 32 ký tự, ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Chế độ supabase (Project Settings → API) ---
# Chỉ dùng khóa anon/publishable. Không bao giờ đặt service_role key vào ứng dụng web.
SUPABASE_URL=
SUPABASE_ANON_KEY=
